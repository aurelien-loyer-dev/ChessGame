# Cloud accounts (optional). Leave empty to keep profiles local to each browser.
# Supabase project → Settings → API: Project URL and anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Sign-in buttons to show, among github, google.
VITE_AUTH_PROVIDERS=github,google

# Self-hosted PeerJS broker for online play (optional, defaults to 0.peerjs.com).
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_SECURE=
